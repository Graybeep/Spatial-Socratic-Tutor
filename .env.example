# Copy to .env and fill in. .env is gitignored and never committed (CLAUDE.md §13.1).
# Every value here has a working default in server/config.py except the API key.

# --- provider -----------------------------------------------------------------
# Which wire format server/llm.py speaks. The SCHEMA does not change between
# them: both are asked to fill the same pydantic model under a forced tool call.
#   anthropic  {base}/v1/messages, x-api-key, tools + tool_choice
#   groq       {base}/openai/v1/chat/completions, Bearer, OpenAI functions
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com

# A local OpenAI-compatible server (LM Studio's default port). No key - it is
# this machine, so `_invoke`'s credential guard does not apply and the
# pre-flight's daily-token check reports "not applicable" rather than passing.
#
# Measured on this machine 2026-09-22, one real turn end to end:
#   Call 1  qwen/qwen3.5-9b    56.8s   3,406 tokens
#   Call 2  google/gemma-4-e4b 24.3s   1,947 tokens
# against Groq's 2.3s p50 on Call 1. Hence the 180s default timeouts - a 10s
# cloud timeout fails every local call before it finishes thinking.
LOCAL_BASE_URL=http://127.0.0.1:1234

# THERE IS NO TEMPERATURE SETTING. Sampling parameters are removed on the
# Claude 5 models and sending one returns a 400. `effort` replaced it:
# low | medium | high | xhigh | max.

# Call 1 — diagnosis and decision (~120 output tokens, see CLAUDE.md §5)
#
# THE DEFAULTS BELOW FOLLOW LLM_PROVIDER. Under `groq` they resolve to
# openai/gpt-oss-120b at 1500 max_tokens instead, because a reasoning model
# spends output tokens BEFORE the tool call: measured 534–580 completion tokens
# on Call 1, where Claude emits the call directly in ~120. At 300 the response
# truncates before the tool call exists and Groq reports "model did not call a
# tool" — which reads like the model cannot do it, and is not that.
# LEAVE THESE COMMENTED unless you mean to pin them. A value set here BEATS the
# provider default, so a pinned `claude-opus-5` is sent to a local server as-is
# and comes back a 400. Commented, each provider resolves its own:
#
#   provider    CALL1_MODEL              CALL2_MODEL
#   anthropic   claude-opus-5            claude-haiku-4-5
#   groq        openai/gpt-oss-120b      openai/gpt-oss-20b
#   local       qwen/qwen3.5-9b          google/gemma-4-e4b
#
# The `local` defaults name the two models this was developed against and will
# not exist on your machine - set both explicitly for that provider.
# Timeouts resolve the same way: 10s on the cloud providers, 180s on `local`,
# where one Call 1 measured 56.8s.
# CALL1_MODEL=claude-opus-5
# CALL1_MAX_TOKENS=300
# INERT UNDER groq AND local. Anthropic's depth control has no OpenAI-shaped
# equivalent and is dropped rather than mapped onto max_tokens or a temperature.
CALL1_EFFORT=medium
# Groq measured p50 2.3s to a validated Call 1 decision, a local 9B 56.8s. The
# default follows the provider; uncomment only to override it.
# CALL1_TIMEOUT_S=10

# Call 2 — utterance only. One sentence from an action, a hint level and some
# node labels: no answer, no item, nothing to reason about. Haiku, because Opus
# here spends seconds of a 4.5s p95 budget for no judgement.
# CALL2_MODEL=claude-haiku-4-5
# CALL2_MAX_TOKENS=250
CALL2_EFFORT=low
# CALL2_TIMEOUT_S=10
# Under groq: openai/gpt-oss-20b at 1200. Same reason as Call 1.

# Retries per call, on transport error or schema-invalid output. Every one is
# logged (§10: no silent retries).
LLM_MAX_RETRIES=1

# A 429 is a WAIT, not a failed attempt, so it has its own budget: retrying
# instantly burns every retry inside the window the server just asked us to wait
# out. Groq's free tier is 8,000 tokens/minute and one Call 1 costs ~2,750, so a
# run of any length spends most of its wall clock here.
LLM_MAX_RATE_LIMIT_WAITS=5
LLM_RATE_LIMIT_DEFAULT_WAIT_S=20
LLM_RATE_LIMIT_MAX_WAIT_S=60

# Real calls are off by default; the mock needs no key and no network.
MOCK_MODE=true

# Paths
GRAPH_PATH=data/graph.json
ITEMS_PATH=data/items.json
GOLD_GRAPH_PATH=data/gold_graph.json
PROMPTS_DIR=prompts
STATE_DB_PATH=state.db
LOG_DIR=logs

# Server
HOST=127.0.0.1
PORT=8000

# Guards (CLAUDE.md §6)
HINT_MAX=4
TURN_BUDGET=8
ANSWER_FUZZY_THRESHOLD=0.9
# Layer 1 answer monitor. NOT an embedding cosine -- see server/guards.py.
# Cosine over token-frequency vectors, so this is not 0.85 and should not be
# set to it; the two metrics are not on the same scale.
ANSWER_SIMILARITY_THRESHOLD=0.55
SHORT_ANSWER_TOKEN_CUTOFF=5
RETRIEVAL_SCORE_FLOOR=0.35

# Narrowing ladder (CLAUDE.md §9.1, §9.2) -- a RESEARCH VARIABLE, swept by the eval.
# Candidates lit per hint level; 0 = no narrowing. Entries below the guess-
# probability floor are clamped up to it.
NARROW_SCHEDULE=0,12,9,7,5
# POLICY KNOB, NOT A MEASUREMENT. Sets the narrowing floor: floor = ceil(1/p),
# so 0.2 -> 5 candidates. Do not raise it to 0.5; 2-of-N is a coin flip.
# Never report 1/N as leakage: it is a lower bound that assumes uniform choice,
# and eval/adversarial.py measures partial-knowledge students well above it.
MAX_GUESS_PROBABILITY=0.2
# interleaved (production) | visual_only | verbal_only | none
# `none` disables hints entirely and is the no-interface baseline eval/adversarial
# subtracts. NOT verbal_only: a verbal hint still eliminates candidates by name.
LADDER_MODE=interleaved

# Mastery (CLAUDE.md §7)
MASTERY_THRESHOLD=0.6
K_START=0.4
K_MIN=0.15
K_DECAY=0.15
HINT_DIFFICULTY_SLOPE=0.5
PREREQ_DECAY=0.05

# Curriculum movement (CLAUDE.md §7)
#
# CONSECUTIVE_FAILURES_BEFORE_BACKTRACK is the server's own rule and always
# applies. MODEL_BACKTRACK is whether Call 1 may ALSO move the student
# backwards by asking. Off by default: a curriculum move is a decision §5 keeps
# in Python, and with this off every `backtrack` the model requests degrades to
# BACKTRACK_REFUSED_ACTION instead. Every measurement in the report was taken
# under MODEL_BACKTRACK=false.
#
# Turned on, the request is still honoured only against a prerequisite below
# MASTERY_THRESHOLD - §7 backtracks to close a gap, and a mastered prerequisite
# is not one.
CONSECUTIVE_FAILURES_BEFORE_BACKTRACK=2
MODEL_BACKTRACK=false
BACKTRACK_REFUSED_ACTION=hint_visual

# Demo pre-flight (python -m server.preflight)
#
# TPD_LIMIT is the provider's tokens-per-day allowance on the Call 1 model;
# Groq's free tier is 200,000. It is the limit that ends a recording session -
# the 8,000 TPM limit only paces a take.
#
# TAKE_BUDGET is what one take is expected to cost. 40,000 is PROVISIONAL and
# nothing has measured a take yet; run `python -m server.preflight --report`
# after the rehearsal and replace it with the figure from the ledger.
TPD_LIMIT=200000
TAKE_BUDGET=40000

# Client
VITE_API_BASE_URL=http://127.0.0.1:8000
